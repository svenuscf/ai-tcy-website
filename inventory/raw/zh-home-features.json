"shouldRenderUnderlay":true,"image":{"hasAnimation":false,"alt":"_edited.jpg","width":3000,"height":1677,"uri":"54385b_34b0d48f8850456f8c8758ba9cd98790~mv2.jpg","title":"_edited.jpg","containerId":"comp-m2qqvkrv","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"containerWidth":980,"containerHeight":247},"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"播放","pauseLabel":"暫停"}},"comp-m2qqwa3a":{"html":"<h1 class=\"font_4 wixui-rich-text__text\" style=\"line-height:1.25em; text-align:center; font-size:72px;\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\"><span style=\"text-shadow:rgba(0, 0, 0, 0.298039) 0px 5px 0px;\" class=\"wixui-rich-text__text\">謝俊仁<br class=\"wixui-rich-text__text\">\n<span style=\"font-size:64px;\" class=\"wixui-rich-text__text\">古琴創作樂曲、打譜與論文</span></span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-l9bya04j":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-l9bya04j","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"播放","pauseLabel":"暫停"}},"comp-kumrauer6":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-kumrauer6","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false}},"comp-kumraues":{"fillLayers":{"containerId":"comp-kumraues","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":489}},"translations":{"ariaLabel":"內容在浮動時改變"}},"comp-kumraues1":{"html":"<h6 class=\"font_6 wixui-rich-text__text\" style=\"text-align:center; font-size:40px;\"><span style=\"font-family:dinneuzeitgroteskltw01-_812426,sans-serif;\" class=\"wixui-rich-text__text\"><span style=\"color:#FFFFFF;\" class=\"wixui-rich-text__text\">謝俊仁</span></span></h6>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kumraues2":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:18px;\"><span class=\"color_44 wixui-rich-text__text\">香港琴人，香港中文大學民族音樂學博士。七十年代跟隨蔡雅絲習箏及關聖佑習音樂理論與創作。八十年代追隨關聖佑、劉楚華及蔡德允習古琴。曾多次在香港、內地和海外公開演奏古琴。謝俊仁為退休醫生，退休後曾任香港中文大學音樂系與香港演藝學院兼職講師。現為本港德愔琴社副社長、以及中文大學音樂系古琴導師與副研究員。</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"text-align:justify; font-size:18px;\"><br class=\"wixui-rich-text__text\">\n<span class=\"color_44 wixui-rich-text__text\">謝俊仁多年來積極參與古琴創作、打譜、推廣、教學和研究工作。其創作琴曲<span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\">《<a href=\"https://www.tsechunyan.com/compositions\" target=\"_self\" data-anchor=\"dataItem-kxcday9t\" class=\"wixui-rich-text__text\">雙乙反調》</a></span>被選為中國古琴考試六級選曲之一。主要研究範圍為明清琴曲的音階與律制、苦音、粵樂七律及康熙十四律等，曾發表有關研究論文四十多篇。謝俊仁曾參與《中國古琴名家名曲》、《琴韻繽紛》、《古琴薈珍》、《清音重聞》等唱片之錄音出版，並於2001年和2011年出版其個人唱片<span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.tsechunyan.com/cds-and-books\" target=\"_self\" data-anchor=\"dataItem-kxcd8ot8\" class=\"wixui-rich-text__text\">《一閃燈花墮》</a></span>和<span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.tsechunyan.com/cds-and-books\" target=\"_self\" data-anchor=\"dataItem-kxcd93je\" class=\"wixui-rich-text__text\">《秋月清霜》</a></span>。除傳統琴曲外，唱片亦收錄了其打譜琴曲和現代創作。其<span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.tsechunyan.com/cds-and-books\" target=\"_self\" data-anchor=\"dataItem-kxcayiba\" class=\"wixui-rich-text__text\">《審律尋幽：謝俊仁古琴論文與曲譜集》</a></span>於2016年出版。</span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-kumraues3":{"fillLayers":{"containerId":"comp-kumraues3","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"image":{"alt":"謝俊仁 qin cropped.jpg","width":2406,"height":2832,"uri":"7a7959_48926c570bcc4867943edef403304cee~mv2.jpg","title":"謝俊仁 qin cropped.jpg","containerId":"comp-kumraues3","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","link":{},"encoding":"AVIF","allowWebpAvifTransforms":true,"containerWidth":491,"containerHeight":918},"shouldPadMedia":false,"hasCanvasAnimation":false},"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"columnOverrides":{"width":"100%","contentArea":{"alignment":0.5,"width":491}},"translations":{"ariaLabel":"內容在浮動時改變"}},"comp-l9bya04j1":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-l9bya04j1","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"播放","pauseLabel":"暫停"}},"comp-kumrauet1":{"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"fillLayers":{"containerId":"comp-kumrauet1","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false}},"comp-kumrauet2":{"fillLayers":{"containerId":"comp-kumrauet2","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"image":{"alt":"N8K_7240.JPG","width":7360,"height":4912,"uri":"7a7959_37aa037cabf7421f95108ac6dd43ab94~mv2.jpg","title":"N8K_7240.JPG","containerId":"comp-kumrauet2","hasBgScrollEffect":"","bgEffectName":"","alignType":"center","displayMode":"fill","